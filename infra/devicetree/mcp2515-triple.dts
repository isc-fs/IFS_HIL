/*
 * Device-tree overlay for the BACKPLANE_HIL PCB.
 *
 * Declares three MCP2515 CAN controllers on SPI0, each with its own
 * GPIO chip-select and interrupt line, matching the PCB wiring in
 * tools/hw_config.py:
 *
 *   can0  CS=GPIO27  INT=GPIO4   (U17, labelled CAN1)
 *   can1  CS=GPIO17  INT=GPIO5   (U19, labelled CAN2)
 *   can2  CS=GPIO18  INT=GPIO6   (U21, labelled CAN3)
 *
 * Replaces `dtoverlay=spi0-0cs` in /boot/firmware/config.txt. Once
 * loaded, the chips are owned by the kernel `mcp251x` driver — the
 * register-level Python driver in tools/mcp2515.py must NOT be used
 * against them concurrently.
 *
 * Supporting firmware-stage config.txt entries required alongside:
 *   gpio=7=op,dl     # assert PS_ON# early so PWR_OK is HIGH before
 *                    # the kernel probes mcp251x (the SPI MISO buffer
 *                    # SN74LVC125A ~OE is gated by PWR_OK).
 *   gpio=8=ip,pd     # PWR_OK as pulled-down input, not leftover SPI0_CE0.
 *
 * This overlay mirrors the structure of the stock `mcp2515-can0.dtbo`
 * (decompiled from /boot/firmware/overlays/mcp2515-can0.dtbo) and
 * extends it to three chips on custom CS GPIOs:
 *   - Per-device pinctrl state that configures the INT GPIO as input,
 *     applied at the right point in the device lifecycle.
 *   - IRQ_TYPE_LEVEL_LOW (= 8) on the interrupt, which is what the
 *     mcp251x driver expects with IRQF_ONESHOT.
 *   - cs-gpios = <27,17,18> to route the three kernel CS lines to our
 *     PCB CS pins.
 *   - pinctrl-0 on spi0 restricted to MISO/MOSI/SCLK only, so GPIO7/8
 *     stay reserved for PSU_ON/PWR_OK.
 */

/dts-v1/;
/plugin/;

/ {
    compatible = "brcm,bcm2835";

    /* Fixed-clock node that the mcp251x driver reads via clk_get_rate(). */
    fragment@0 {
        target-path = "/";
        __overlay__ {
            mcp2515_osc: mcp2515_osc {
                compatible = "fixed-clock";
                #clock-cells = <0>;
                clock-frequency = <16000000>;
            };
        };
    };

    /* Pinctrl states: SPI0 data pins, and one input state per INT pin. */
    fragment@1 {
        target = <&gpio>;
        __overlay__ {
            spi0_data_only_pins: spi0_data_only_pins {
                brcm,pins = <9 10 11>;
                brcm,function = <4>;             /* alt0 = SPI */
                brcm,pull = <0 0 0>;
            };

            can0_int_pin: can0_int_pin {
                brcm,pins = <4>;
                brcm,function = <0>;             /* input */
            };

            can1_int_pin: can1_int_pin {
                brcm,pins = <5>;
                brcm,function = <0>;
            };

            can2_int_pin: can2_int_pin {
                brcm,pins = <6>;
                brcm,function = <0>;
            };
        };
    };

    /* Disable default spidev children. */
    fragment@2 {
        target = <&spidev0>;
        __overlay__ {
            status = "disabled";
        };
    };

    fragment@3 {
        target = <&spidev1>;
        __overlay__ {
            status = "disabled";
        };
    };

    /* Configure SPI0: restrict pinctrl to data pins only, declare three
     * GPIO chip-selects, enable the master. */
    fragment@4 {
        target = <&spi0>;
        __overlay__ {
            #address-cells = <1>;
            #size-cells = <0>;
            status = "okay";
            pinctrl-names = "default";
            pinctrl-0 = <&spi0_data_only_pins>;
            /* CS pins, active-low. Eight entries:
             *   0..2: MCP2515 chips on GPIO27/17/18 (PCB)
             *   3:    GPIO16, unused on the PCB — spidev0.3, still no_cs=True +
             *         manual GPIO for the ADCs and the nRF24.
             *   4..7: DAC80504 chip-selects GPIO22/23/24/25 (J2 pads 15/16/18/22).
             *         Moved here from userspace GPIO. Asserting CS outside the SPI
             *         message is a race against the kernel mcp251x driver sharing
             *         this controller: between the broker's GPIO write and spidev's
             *         transfer the kernel is free to clock an MCP2515 message while
             *         the DAC is already selected, so the DAC shifts in edges meant
             *         for someone else. Measured under CAN load: DEVID 0x082E, the
             *         correct 0x0417 shifted left one bit -- one stray clock -- and,
             *         less often, a persistent latch only a rail power-cycle clears
             *         (IFS_HIL#124). With CS declared here the SPI core asserts it
             *         as part of the message, under the controller lock, and the
                        *   8..10: MCP3208 ADCs on GPIO19/20/21 (J2 pads 35/38/40), and
                        *   11:    the nRF24 on GPIO26 (J2 pad 37). Same reasoning as the
                        *          DACs: they used the shared spidev0.3 with userspace CS,
                        *          so they carried the identical race. Nothing had gone
                        *          wrong on them yet, but the mechanism does not care which
                        *          device is selected when a stray MCP2515 message clocks
                        *          the bus. The nRF24's CE and IRQ stay plain GPIO -- only
                        *          the chip-select belongs to the SPI core.
             *         window stops existing. */
            cs-gpios = <&gpio 27 1>, <&gpio 17 1>, <&gpio 18 1>, <&gpio 16 1>,
                       <&gpio 22 1>, <&gpio 23 1>, <&gpio 24 1>, <&gpio 25 1>,
                       <&gpio 19 1>, <&gpio 20 1>, <&gpio 21 1>, <&gpio 26 1>;

            can0: mcp2515@0 {
                reg = <0>;
                compatible = "microchip,mcp2515";
                pinctrl-names = "default";
                pinctrl-0 = <&can0_int_pin>;
                spi-max-frequency = <10000000>;
                /* SPI mode 3 (CPOL=1, CPHA=1). MCP2515 supports mode 0
                 * and mode 3; on this PCB with the SN74LVC125A MISO
                 * buffer, mode 0 drops the MSB on reads (confirmed via
                 * write-known / read-back test on spi0 at 1 MHz).
                 * Mode 3 round-trips cleanly. */
                spi-cpol;
                spi-cpha;
                interrupt-parent = <&gpio>;
                interrupts = <4 8>;              /* GPIO4, IRQ_TYPE_LEVEL_LOW */
                clocks = <&mcp2515_osc>;
                status = "okay";
            };

            can1: mcp2515@1 {
                reg = <1>;
                compatible = "microchip,mcp2515";
                pinctrl-names = "default";
                pinctrl-0 = <&can1_int_pin>;
                spi-max-frequency = <10000000>;
                spi-cpol;
                spi-cpha;
                interrupt-parent = <&gpio>;
                interrupts = <5 8>;              /* GPIO5, IRQ_TYPE_LEVEL_LOW */
                clocks = <&mcp2515_osc>;
                status = "okay";
            };

            can2: mcp2515@2 {
                reg = <2>;
                compatible = "microchip,mcp2515";
                pinctrl-names = "default";
                pinctrl-0 = <&can2_int_pin>;
                spi-max-frequency = <10000000>;
                spi-cpol;
                spi-cpha;
                interrupt-parent = <&gpio>;
                interrupts = <6 8>;              /* GPIO6, IRQ_TYPE_LEVEL_LOW */
                clocks = <&mcp2515_osc>;
                status = "okay";
            };

            /* /dev/spidev0.3 lives here so the register-level Python
             * driver keeps reaching the DACs, ADCs, and nRF24 via
             * no_cs=True + manual GPIO CS. GPIO16 is the nominal CS but
             * it is ignored in practice (no_cs=True) and is not wired
             * anywhere on the PCB. */
            spidev@3 {
                reg = <3>;
                compatible = "spidev";
                spi-max-frequency = <1000000>;
                status = "okay";
            };

            /* The four DAC80504s, one spidev each, CS owned by the kernel.
             *
             * spi-cpha with no spi-cpol is SPI MODE 1 (CPOL=0, CPHA=1): the
             * DAC80504 drives SDO on the rising edge of SCLK, so the master
             * must sample on the falling edge. The broker used to flip the
             * shared spidev between mode 0 and mode 1 around every DAC
             * transaction; declaring it per device means the SPI core
             * programs it per message and that juggling disappears too. */
            spidev@4 {
                reg = <4>;                       /* GPIO22 — J2 pad 15 */
                compatible = "spidev";
                spi-max-frequency = <1000000>;
                spi-cpha;
                status = "okay";
            };

            spidev@5 {
                reg = <5>;                       /* GPIO23 — J2 pad 16 */
                compatible = "spidev";
                spi-max-frequency = <1000000>;
                spi-cpha;
                status = "okay";
            };

            spidev@6 {
                reg = <6>;                       /* GPIO24 — J2 pad 18 */
                compatible = "spidev";
                spi-max-frequency = <1000000>;
                spi-cpha;
                status = "okay";
            };

            spidev@7 {
                reg = <7>;                       /* GPIO25 — J2 pad 22 */
                compatible = "spidev";
                spi-max-frequency = <1000000>;
                spi-cpha;
                status = "okay";
            };

            /* MCP3208 ADCs and the nRF24. Mode 0 (CPOL=0, CPHA=0) -- no
             * spi-cpol/spi-cpha -- which is what the shared node was set to
             * and what both parts expect (mcp3208.py:14, nrf24l01.py). The
             * MCP3208 tolerates 2 MHz; 1 MHz here matches SPI_MAX_HZ. */
            spidev@8 {
                reg = <8>;                      /* GPIO19 — J2 pad 35, ADC1 */
                compatible = "spidev";
                spi-max-frequency = <1000000>;
                status = "okay";
            };

            spidev@9 {
                reg = <9>;                      /* GPIO20 — J2 pad 38, ADC2 */
                compatible = "spidev";
                spi-max-frequency = <1000000>;
                status = "okay";
            };

            spidev@a {
                reg = <10>;                      /* GPIO21 — J2 pad 40, ADC3 */
                compatible = "spidev";
                spi-max-frequency = <1000000>;
                status = "okay";
            };

            spidev@b {
                reg = <11>;                      /* GPIO26 — J2 pad 37, nRF24 */
                compatible = "spidev";
                spi-max-frequency = <1000000>;
                status = "okay";
            };


        };
    };
};
